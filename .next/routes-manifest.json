{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/work/project/[slug]",
      "regex": "^/work/project/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/work/project/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[lang]",
      "regex": "^/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[lang]/category/[slug]",
      "regex": "^/([^/]+?)/category/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang",
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/category/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[lang]/product/[id]",
      "regex": "^/([^/]+?)/product/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang",
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/product/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/contact",
      "regex": "^/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contact(?:/)?$"
    },
    {
      "page": "/layout",
      "regex": "^/layout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/layout(?:/)?$"
    },
    {
      "page": "/work",
      "regex": "^/work(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/work(?:/)?$"
    }
  ],
  "dataRoutes": [
    {
      "page": "/",
      "dataRouteRegex": "^/_next/data/HpWqGdfLgNhSVRTs2ntbW/index\\.json$"
    },
    {
      "page": "/work",
      "dataRouteRegex": "^/_next/data/HpWqGdfLgNhSVRTs2ntbW/work\\.json$"
    },
    {
      "page": "/work/project/[slug]",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "dataRouteRegex": "^/_next/data/HpWqGdfLgNhSVRTs2ntbW/work/project/([^/]+?)\\.json$",
      "namedDataRouteRegex": "^/_next/data/HpWqGdfLgNhSVRTs2ntbW/work/project/(?<nxtPslug>[^/]+?)\\.json$"
    },
    {
      "page": "/[lang]",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "dataRouteRegex": "^/_next/data/HpWqGdfLgNhSVRTs2ntbW/([^/]+?)\\.json$",
      "namedDataRouteRegex": "^/_next/data/HpWqGdfLgNhSVRTs2ntbW/(?<nxtPlang>[^/]+?)\\.json$"
    },
    {
      "page": "/[lang]/category/[slug]",
      "routeKeys": {
        "nxtPlang": "nxtPlang",
        "nxtPslug": "nxtPslug"
      },
      "dataRouteRegex": "^/_next/data/HpWqGdfLgNhSVRTs2ntbW/([^/]+?)/category/([^/]+?)\\.json$",
      "namedDataRouteRegex": "^/_next/data/HpWqGdfLgNhSVRTs2ntbW/(?<nxtPlang>[^/]+?)/category/(?<nxtPslug>[^/]+?)\\.json$"
    },
    {
      "page": "/[lang]/product/[id]",
      "routeKeys": {
        "nxtPlang": "nxtPlang",
        "nxtPid": "nxtPid"
      },
      "dataRouteRegex": "^/_next/data/HpWqGdfLgNhSVRTs2ntbW/([^/]+?)/product/([^/]+?)\\.json$",
